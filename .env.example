# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Create a Telegram bot with @BotFather. Keep token private.
TELEGRAM_BOT_TOKEN=123456:replace_me
TELEGRAM_BOT_USERNAME=your_bot_username
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_CHANNEL_ID=@your_channel
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=https://t.me/your_channel

# Admin login. Use a long random password and a secret of 32+ characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_unique_password
SESSION_SECRET=replace_with_at_least_32_random_characters

# Public production URL, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000
